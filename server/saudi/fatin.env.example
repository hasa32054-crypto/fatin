# إعدادات خادم فطن السعودي. هذا الملف يكون في /etc/fatin.env وصلاحيته 600 (يقراه root وخادم فطن فقط).
PORT=8787
DATA_DIR=/var/lib/fatin
ALLOWED_ORIGIN=https://hasa32054-crypto.github.io

# الذكاء الاصطناعي:
#   cloudflare = يرد الخادم الحالي (سريع، مرحلة انتقالية)
#   local      = نموذج ALLaM السعودي على هذا السيرفر (كل شي داخل المملكة، أبطأ)
#   anthropic  = Claude بمفتاحك (ANTHROPIC_API_KEY)
AI_PROVIDER=cloudflare
UPSTREAM=https://fatin.hasa32054.workers.dev
LLM_URL=http://127.0.0.1:8081/v1/chat/completions
# ANTHROPIC_API_KEY=

# السمع: whisper.cpp على هذا السيرفر (التسجيل ما يطلع من المملكة)
WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/opt/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin

# الصوت (فهد وسارة). الجمل تنحفظ على قرص هذا السيرفر بعد أول مرة
ELEVENLABS_API_KEY=
# TTS_MODEL=eleven_v4_turbo

# حدود لكل مستخدم في 10 دقائق (اختياري)
# TTS_PER_10MIN=120
# STT_PER_10MIN=60
# AI_PER_10MIN=60
# LINK_PER_10MIN=40
